# Copy this file to .env and fill in the section for the provider you're using.
# Only ONE provider block is required.

# ── Choose your provider ────────────────────────────────────────────────
LLM_PROVIDER=anthropic
# LLM_PROVIDER=openai
# LLM_PROVIDER=azure_openai

# ── Anthropic (Claude) ───────────────────────────────────────────────────
# Direct Anthropic API: leave ANTHROPIC_BASE_URL blank.
# Claude via Azure AI Foundry: set ANTHROPIC_BASE_URL to your Foundry
# resource's /anthropic path, use the Foundry API key, and set
# ANTHROPIC_MODEL to your deployment NAME (not Anthropic's own model id).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_BASE_URL=https://<your-resource>.services.ai.azure.com/anthropic

# ── OpenAI direct, or any OpenAI-compatible server (Ollama, vLLM, etc.) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=http://localhost:11434/v1   # example: local Ollama

# ── Azure OpenAI ──────────────────────────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ── Optional: only needed for private repos or posting PR comments ──────
GITHUB_APP_TOKEN=
# Safety switch: the agent will NOT post comments / statuses to GitHub
# unless this is explicitly true, even if a token is set.
GITHUB_POST_REVIEWS=false
# Shared secret you type into the GitHub webhook settings; used to verify
# X-Hub-Signature-256 so only GitHub can trigger reviews.
GITHUB_WEBHOOK_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# LLM_MAX_RETRIES=8   # 429/5xx retries with exponential backoff
